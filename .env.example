# =====================================================================
# .env.example  —  このファイルを .env にコピーして値を入れてください
#   （.env は .gitignore 済み。GitHub には Secrets で設定します）
# =====================================================================

# 【必須】Discord Webhook URL
#   Discord のチャンネル設定 → 連携サービス → ウェブフック で作成
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000/xxxxxxxxxxxxxxxxxxxx

# --- 以下は任意（未設定なら config.py の既定値）---

# 管理者向けエラー通知を別チャンネルに送りたい場合のみ
# DISCORD_ERROR_WEBHOOK_URL=

# Discord へ送信せず動作確認だけする
# MONITOR_DRY_RUN=true

# 監視条件の変更
# MONITOR_SALE_MAX_PRICE=2500000
# MONITOR_RENT_MAX_PRICE=50000

# 有効にする監視元（カンマ区切り）。athome / homes は規約・アクセス制限により非推奨
# MONITOR_ENABLED_SOURCES=awara,suumo

# 自動取得できないサイト（at home / HOME'S）の手動確認リンクを毎日通知する
# MONITOR_SEND_MANUAL_REMINDER=true

# アクセス負荷の調整
# MONITOR_REQUEST_DELAY=4
# MONITOR_MAX_DETAIL_FETCHES=8
# MONITOR_USER_AGENT=AwaraKodateMonitor/1.0 (personal; +https://github.com/yourname/yourrepo)
